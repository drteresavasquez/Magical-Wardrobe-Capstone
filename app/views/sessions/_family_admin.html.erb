<% if @head.family_id == 0 %>
  <div class="row">
    <div class="col-sm-12">
      <center>
          <p><%= link_to 'Add Family', new_family_path, class: "btn btn-info"%></p>
      </center>
    </div>
    </div>
<%else%>
    <div class="row">
      <div class="col-sm-12">
        <center>
          <p><%= link_to 'Add A Family Member', newfamilymember_path, class: "btn btn-info"%></p>
        </center>

        <center><h1><%= @family_name.family_name %> Family</h1></center>
        <p> <center><%= link_to 'Edit', edit_family_path(@family_name), class: "btn btn-warning"%>
        <%= link_to 'Delete', @family_name, method: :delete, class: "btn btn-danger", data: { confirm: 'Are you sure?' } %></center></p>
      </div>
    </div> 
    <hr> 
    
    <div class="row">
      <div class="col-sm-12">
      <% @family.each do |family| %>
        <div class="col-sm-4"> 
            <div class="thumbnail">
              <%= gravatar_for(family, size: '100%') %>
            <div class="caption">
                <h4>&nbsp &nbsp<%=family.name%></h4>
                  <p>
                    <% unless current_user?(family) %>
                    &nbsp &nbsp<%= link_to 'Delete', family, method: :delete, class: "btn btn-danger", data: { confirm: 'Are you sure?' } %></center>
                      <% else %>
                      &nbsp &nbsp<%= link_to 'Edit', edit_user_path(family), class: "btn btn-warning" %>
                      <% end %>
                  </p>
              </div>
            </div>
        </div>          
      <% end %> 
    </div>
  </div>                       
<%end%>
      