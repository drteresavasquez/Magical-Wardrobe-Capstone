</p>
<div class="row">      

  <div class="hide-on-mobile">
    <%= render 'shared/sidebar' %>
  </div>


<div class="row">
  <div class="col-sm-8">
    <center>
      <% if @bottom.empty? %>
      <center><h1>No Bottoms...</h1>
      <%= link_to 'Add a Bottom', new_bottom_path, class: "btn btn-primary" %></center>
      <hr>
    <% else %>
    <center><h1>Bottoms</h1></center>
    <hr>
  <% @bottom.each do |bottom| %>
  <div class="col-sm-4">
    <div class="thumbnail">
      <% if bottom.picture? %>
      <%= link_to image_tag(bottom.picture.url), bottom %> 
      <% end %>
      <div class="caption">
        <h4> 
          <% unless bottom.favorite? %>
          <%= link_to fa_icon("heart", class: "fa fa-heart"), bottom %>
          <% else %>
          <%= link_to fa_icon("heart", class: "fa fa-heart fav"), bottom %>
          <!-- <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span> -->
          <% end %>
          <%= bottom.name %> #<%= bottom.item_id %>
        </h4>
        <p><strong>Status:</strong>
          <% if bottom.active? %>
          Clean
          <% else %>
          Dirty
          <% end %></p>
          <p><strong>Wearer:</strong> <%=User.find(bottom.wearer_id).name %></p>
          <%= form_for(bottom) do |form| -%>
          <% if bottom.active? %>
          <%= form.hidden_field :active, :value => false %>
          <%= submit_tag 'Wear This!', class: "btn btn-info" -%>
            <% else %>
            <%= form.hidden_field :active, :value => true %>
            <%= submit_tag 'Wash This!', class: "btn btn-warning" -%>
          <% end %>
          <% end %>
        <p> <center><%= link_to 'Info', bottom, class: "btn btn-info"%>
          <%= link_to 'Edit', edit_bottom_path(bottom), class: "btn btn-warning" %>
          <%= link_to 'Delete', bottom, method: :delete, class: "btn btn-danger", data: { confirm: 'Are you sure?' } %></center></p>
      </div>
    </div>
  </div>
  <% end %>
  <% end %>
</center>
</div>
</div>
</div>