<div class="row">      
    <div class="row">
      <div class="hide-on-mobile">
        <%= render 'shared/sidebar' %>
      </div>
    </div>
    <div class="row">
        <div class="col-sm-8">
        <center><h3>
            <% unless @bottom.favorite? %>
            <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
            <% else %>
            <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span>
            <% end %>
            <%= @bottom.name %> #<%= @bottom.id %></h3>
            <%= image_tag @bottom.picture.url if @bottom.picture? %>
    
      <p>
          <strong>Status:</strong>
          <% if @bottom.active? %>
            Clean
            <% else %>
            Dirty
            <% end %>
        </p>
    
        <p>
          <strong>Weather Type:</strong>
          <%= @bottom.weather_type.name %>
        </p>
        <p>
          <strong>Temperature Type:</strong>
          <%= @bottom.temperature_type.name %>
        </p>
    
        <p>
          <strong>Bottom type:</strong>
          <%= @bottom.bottom_type.name %>
        </p>
    
        <p>
          <strong>Style:</strong>
          <%= @bottom.style_type.name %>
        </p>
    
        <p>
          <strong>Description:</strong>
          <%= @bottom.description %>
        </p>
        <%= form_for(@bottom) do |form| -%>
          <% if @bottom.active? %>
          <%= form.hidden_field :active, :value => false %>
          <%= submit_tag 'Wear This!', class: "btn btn-info wearthis" -%>
            <% else %>
            <%= form.hidden_field :active, :value => true %>
            <%= submit_tag 'Wash This!', class: "btn btn-warning wearthis" -%>
          <% end %>
          <% end %>
    
          <%= link_to 'See All Bottoms', bottoms_path, class: "btn btn-primary" %>  
          <%= link_to 'Edit', edit_bottom_path(@bottom), class: "btn btn-primary" %>
           <%= link_to 'Delete', @bottom, method: :delete, class: "btn btn-danger", data: { confirm: 'Are you sure?' } %>
          </center>
          </div>
        </div>
      </div>