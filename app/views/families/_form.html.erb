<%= form_for(@family) do |form| %>
  <% if family.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(family.errors.count, "error") %> prohibited this family from being saved:</h2>

      <ul>
      <% family.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  
  <%= form.hidden_field :user_id, :value => current_user.id %>
  <%= form.hidden_field :family_id, :value => current_user.id %>
  <%= form.hidden_field :admin, :value => true %>

  <div class="field">
    <%= form.label :family_name %>
    <%= form.text_field :family_name, class: 'form-control' %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
