<%= form_for(@new_fam) do |f| %>
<%= render 'shared/new_fam_error_messages', object: @new_fam %>

<%= f.hidden_field :family_id, :value => current_user.family_id %>
<%= f.hidden_field :activated, :value => true %>

<%= f.label :name %>
<%= f.text_field :name, class: 'form-control' %>

<%= f.label :email %>
<%= f.email_field :email, class: 'form-control' %>

<%= f.label :zip_code %>
<%= f.text_field :zip_code, class: 'form-control' %>

<%= f.label :password %>
<%= f.password_field :password, class: 'form-control' %>

<%= f.label :password_confirmation %>
<%= f.password_field :password_confirmation, class: 'form-control' %>

<div class="field">
    <%= f.label :family_admin %>
    <%= f.check_box :family_admin, class: 'form-control' %>
</div>

<div class="col-sm-12 center">
<%= f.submit yield(:button_text), class: "btn btn-primary btn-lg form-btn" %>
</div>
<% end %>