<%= form_for(@outfit) do |form| %>
  <% if outfit.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(outfit.errors.count, "error") %> prohibited this outfit from being saved:</h2>

      <ul>
      <% outfit.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :user_id, :value => current_user.id %>
  <%= form.hidden_field :active, :value => true %>

  <% if User.find(current_user.id).family_id == 0 || !current_user.family_admin? %>
    <%= form.hidden_field :wearer_id, :value => current_user.id %>
  <% else %>
  <div class="field wearer">
      <%= form.label :wearer_id %>
      <%= form.collection_select :wearer_id, @person, :id, :name, :prompt => "Select a Family Member" %>
  </div>
  <% end %>

  <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, class: 'form-control' %>
    </div>

    <div class="field">
        <%= form.label :weather_type_id %>
        <%= form.collection_select :weather_type_id, @weather, :id, :name , :prompt => "Select a Weather Type"%>
      </div>

      <div class="field">
          <%= form.label :temperature_type_id %>
          <%= form.collection_select :temperature_type_id, @temp, :id, :name , :prompt => "Select a Temperature Type"%>
        </div>
    
    <div class="field">
        <%= form.label :style_type_id %>
        <%= form.collection_select :style_type_id, @style, :id, :name, :prompt => "Select a Style"%>
      </div>
      
      <div class="field">
          <%= form.label :top_id %>
        <%= form.select :top_id, options_for_select(@top.all.map{|c| ["#{User.find(c.wearer_id).name}: #{c.name} (#{TopType.find(c.top_type_id).name})"]}, form.object.id), {:prompt => "Select a Top"}, {} %>
      </div>

      <div class="field">
          <%= form.label :bottom_id %>
          <%= form.select :bottom_id, options_for_select(@bottom.all.map{|c| ["#{User.find(c.wearer_id).name}: #{c.name} (#{BottomType.find(c.bottom_type_id).name})"]}, form.object.id), {:prompt => "Select a Bottom"}, {} %>
        </div>

      <div class="field">
          <%= form.label :accessory_id %>
          <%= form.select :accessory_id, options_for_select(@accessory.all.map{|c| ["#{User.find(c.wearer_id).name}: #{c.name} (#{AccessoryType.find(c.accessory_type_id).name})"]}, form.object.id), {:include_blank => "Nothing selected"}, {} %>
        </div>

        <div class="field">
            <%= form.label :footwear_id %>
            <%= form.select :footwear_id, options_for_select(@footwear.all.map{|c| ["#{User.find(c.wearer_id).name}: #{c.name} (#{FootwearType.find(c.footwear_type_id).name})"]}, form.object.id), {:include_blank => "Nothing selected"}, {} %>
          </div>

          <div class="field">
            <%= form.label "Outerwear" %>
            <%= form.select :outterwear_id, options_for_select(@outterwear.all.map{|c| ["#{User.find(c.wearer_id).name}: #{c.name} (#{OutterwearType.find(c.outterwear_type_id).name})"]}, form.object.id), {:include_blank => "Nothing selected"}, {} %>
          </div>

        <div class="field">
            <%= form.label :description %>
            <%= form.text_field :description, class: 'form-control' %>
          </div>

        <div class="field">
            <%= form.label :favorite %>
            <%= form.check_box :favorite, class: 'form-control' %>
          </div>
          
        <span class="picture">
            <%= form.file_field :picture, accept: 'image/jpeg,image/gif,image/png' %>
          </span>

  <div class="actions center">
    <%= form.submit yield(:button_text), class: "btn btn-primary btn-lg form-btn" %>
  </div>
<% end %>
