<%= form_for(@outfit) do |form| %>
  <% if outfit.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(outfit.errors.count, "error") %> prohibited this outfit from being saved:</h2>

      <ul>
      <% outfit.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :user_id, :value => current_user.id %>
  <%= form.hidden_field :active, :value => true %>

  <div class="field">
      <%= form.label :wearer_id %>
      <%= form.collection_select :wearer_id, @person, :id, :name , :prompt => "Select a Family Member"%>
  </div>

  <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, class: 'form-control' %>
    </div>

    <div class="field">
        <%= form.label :weather_type_id %>
        <%= form.collection_select :weather_type_id, @weather, :id, :name , :prompt => "Select a Weather Type"%>
      </div>

      <div class="field">
          <%= form.label :temperature_type_id %>
          <%= form.collection_select :temperature_type_id, @temp, :id, :name , :prompt => "Select a Temperature Type"%>
        </div>
    
    <div class="field">
        <%= form.label :style_type_id %>
        <%= form.collection_select :style_type_id, @style, :id, :name, :prompt => "Select a Style"%>
      </div>
      
      <div class="field">
          <%= form.label :top_id %>
        <%= form.collection_select :top_id, @top, :id, :name, :prompt => "Select a Top"%>
      </div>

      <div class="field">
          <%= form.label :bottom_id %>
          <%= form.collection_select :bottom_id, @bottom, :id, :name, :prompt => "Select a Bottom"%>
        </div>

      <div class="field">
          <%= form.label :accessory_id %>
          <%= form.collection_select :accessory_id, @accessory, :id, :name, :include_blank => "Nothing selected"%>
        </div>

        <div class="field">
            <%= form.label :footwear_id %>
            <%= form.collection_select :footwear_id, @footwear, :id, :name, :include_blank => "Nothing selected"%>
          </div>

        <div class="field">
            <%= form.label :description %>
            <%= form.text_field :description, class: 'form-control' %>
          </div>

        <div class="field">
            <%= form.label :favorite %>
            <%= form.check_box :favorite, class: 'form-control' %>
          </div>
          
        <span class="picture">
            <%= form.file_field :picture, accept: 'image/jpeg,image/gif,image/png' %>
          </span>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
