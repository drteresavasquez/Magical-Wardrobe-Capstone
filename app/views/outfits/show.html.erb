<div class="row">

    <div class="hide-on-mobile">
      <%= render 'shared/sidebar' %>
    </div>

  <div class="row">
    <div class="col-sm-8">
      <center>
        <div class="row">
          <div class="col-sm-12">
            <h3>
              <% unless @outfit.favorite? %>
                <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
                <% else %>
                  <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span>
                  <% end %>
                  <%= @wearer.name %>'s <%= @outfit.name %> 
                    #<%= @outfit.item_id %> 
            </h3>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-12">
            <%= image_tag @outfit.picture.url if @outfit.picture? %>
          </div>
        </div>
        <div class="row">
            <% unless @outterwear == 0 %>
            <div class="col-sm-12 outfit">
              <h4>Outerwear #
                <%= @outterwear.item_id %>
                  <br>
                  <% if @outterwear.picture? %>
                  <%= link_to image_tag(@outterwear.picture.url), @outterwear%>
                  <%end%>
              </h4>
            </div>
            <% else %>
              <div class="display_none">
              </div>
              <% end %>
        </div>

        <div class="row center">
          <div class="col-sm-3 outfit">
            <h4>Top #
              <%= @top.item_id %>
                <br>
                <%= link_to image_tag(@top.picture.url), @top %>
            </h4>
          </div>

          <div class="col-sm-3 outfit">
            <h4>Bottom #
              <%= @bottom.item_id %>
                <br>
                <%= link_to image_tag(@bottom.picture.url), @bottom %>
            </h4>
          </div>

          <% unless @footwear == 0 %>
            <div class="col-sm-3 outfit">
              <h4>Footwear #
                <%= @footwear.item_id %>
                  <br>
                  <% if @footwear.picture? %>
                  <%= link_to image_tag(@footwear.picture.url), @footwear%>
                  <%end%>
              </h4>
            </div>
            <% else %>
              <div class="display_none">
              </div>
              <% end %>

                <% unless @accessory == 0 %>
                  <div class="col-sm-3 outfit">
                    <h4>Accessory #
                      <%= @accessory.item_id %>
                        <br>
                        <% if @accessory.picture? %>
                        <%= link_to image_tag(@accessory.picture.url),@accessory %>
                        <%end%>
                    </h4>
                  </div>
                  <% else %>
                    <div class="display_none">
                    </div>
                    <% end %>

                      <div class="col-sm-12">

                        <p>Owner: <%= @wearer.name %></p>
                        <p>
                          <strong>Status:</strong>
                          <% if @outfit.active? %>
                            Clean
                            <% else %>
                              Dirty
                              <% end %>
                        </p>

                        <p>
                          <strong>Weather Type:</strong>
                          <%= @outfit.weather_type.name %>
                        </p>

                        <p>
                          <strong>Style:</strong>
                          <%= @outfit.style_type.name %>
                        </p>

                        <p>
                          <strong>Description:</strong>
                          <%= @outfit.description %>
                        </p>

                        <%= form_for(@outfit) do |form| -%>
                          <% if @outfit.active? %>
                            <%= form.hidden_field :active, :value => false %>
                              <%= submit_tag 'Wear This!', class: "btn btn-info wearthis" -%>
                                <% else %>
                                  <%= form.hidden_field :active, :value => true %>
                                    <%= submit_tag 'Wash This!', class: "btn btn-warning wearthis" -%>
                                      <% end %>
                                        <% end %>

                                          <%= link_to 'See All Outfits', outfits_path, class: "btn btn-primary" %>
                                            <%= link_to 'Edit', edit_outfit_path(@outfit), class: "btn btn-primary" %>
                                              <%= link_to 'Delete', @outfit, method: :delete, class: "btn btn-danger", data: { confirm: 'Are you sure?' } %>

                      </div>
      </center>
      </div>
    </div>
  </div>
</div>