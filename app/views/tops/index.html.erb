</p>
  <div class="row">      
  <div class="row">
    <div class="hide-on-mobile">
      <%= render 'shared/sidebar' %>
    </div>
 </div>

 <div class="row">
    <div class="col-sm-8">
        <% if @top.empty? %>
        <center><h3>You Don't Have Any Tops...</h3>
        <%= link_to 'Add a Top', new_top_path, class: "btn btn-primary" %></center>
      <% else %>
      <center><h1>Tops</h1></center>
    <% @top.each do |top| %>
    <div class="col-sm-4">
      <div class="thumbnail">
        <% if top.picture? %>
        <%= link_to image_tag(top.picture.url), top %> 
        <% end %>
        <div class="caption">
          <h4> 
              <%= form_for(top) do |form| -%>
              <% if top.favorite? %>
              <%= form.hidden_field :favorite, :value => false %>
              <%= submit_tag 'fav', class: "btn glyphicon glyphicon-heart" -%>
                <% else %>
                <%= form.hidden_field :favorite, :value => true %>
               <%= submit_tag fa_icon 'fa-envelope lg', class: "btn glyphicon glyphicon-heart" -%>
             
              <% end %>
              <% end %>


            <% unless top.favorite? %>
            <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
            <% else %>
            <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span>
            <% end %>
            <%= top.name %>
          </h4>
          <p> <%= link_to 'Info', top, class: "btn btn-info"%>
            <%= link_to 'Edit', edit_top_path(top), class: "btn btn-warning" %>
            <%= link_to 'Delete', top, method: :delete, class: "btn btn-danger", data: { confirm: 'Are you sure?' } %></p>
        </div>
      </div>
    </div>
    <% end %>
    <% end %>
  </div>
  </div>
  </div>