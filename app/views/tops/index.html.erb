<p id="notice">
    <%= notice %>
  </p>
  <div class="row">      
  <div class="row">
    <div class="hide-on-mobile">
      <%= render 'shared/sidebar' %>
    </div>
 </div>

 <div class="row">
    <div class="col-sm-8">
        <% if @top.empty? %>
        <center><h3>You Don't Have Any Tops...</h3>
        <%= link_to 'Add a Top', new_top_path, class: "btn btn-primary" %></center>
      <% else %>
      <center><h1>Tops</h1></center>
    <% @top.each do |top| %>
    <div class="col-sm-4">
      <div class="thumbnail">
        <%= image_tag top.picture.url if top.picture? %> 
        <div class="caption">
          <h5><%= top.name %></h5>
          <p> <%= link_to 'Show', top, class: "btn btn-primary"%>
            <%= link_to 'Edit', edit_top_path(top), class: "btn btn-primary" %>
            <%= link_to 'Delete', top, method: :delete, class: "btn btn-danger", data: { confirm: 'Are you sure?' } %></p>
        </div>
      </div>
    </div>
    <% end %>
    <% end %>
  </div>
  </div>
  </div>