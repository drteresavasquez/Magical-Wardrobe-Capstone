<p id="notice">
  <%= notice %>
</p>

<h1>Tops
  <%= link_to 'New Top', new_top_path, class: "btn btn-primary" %>
</h1>

<div class="col-sm-9">
  <div class="row">
    <% @tops.each do |top| %>
      <div class="col-sm-4">
        <div class="thumbnail">
          <%= image_tag top.picture.url if top.picture? %>
            <div class="caption">
              <%= top.name %>
                <p>
                  <%= top.description %>
                    <%= top.favorite %>
                </p>
                <p>
                  <%= link_to 'Show', top, class: "btn btn-primary"%>
                    <%= link_to 'Edit', edit_top_path(top), class: "btn btn-primary" %>
            </div>
        </div>
      </div>
      <% end %>
  </div>
</div>