<p id="notice">
    <%= notice %>
  </p>
  
  <h1>Tops
    <%= link_to 'New Top', new_top_path, class: "btn btn-primary" %>
  </h1>
  <div class="col-sm-12">
    <div class="row">
      <% @tops.each do |top| %>
        <div class="card col-sm-3">
            <img class="card-img-top"  alt="Card image cap" <%= image_tag top.picture.url if top.picture? %> 
            <div class="card-body">
              <h4 class="card-title"> <%= top.name %></h4>
                    <%= link_to 'Show', top, class: "btn btn-primary"%>
                    <%= link_to 'Edit', edit_top_path(top), class: "btn btn-primary" %>
                    <%= link_to 'Delete', top, method: :delete, class: "btn btn-danger", data: { confirm: 'Are you sure?' } %>
                   
            </div>
          </div>
        <% end %>
    </div>
  </div>

