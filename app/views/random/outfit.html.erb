<div class="row">

    <div class="hide-on-mobile">
        <%= render 'shared/sidebar' %>
    </div>

    <div class="row">
        <div class="col-sm-8">
            <center>
                <div class="row">
                    <div class="col-sm-12">
                        <% unless @selected.nil? %>
                            <h2> Temperature:
                                <%= @temp_type %> (
                                    <%=@temp%>&#8457;)</h2>
                            <h4>The weather today:
                                <%= @weather %>
                                    <br>
                            </h4>
                           
                    </div>
                </div>
                <hr>
                
                <% else %>
                    <h3>You don't have any available outfits for this
                        <%= @temp_type %> (<%=@temp%>&#8457;) day.</h3>
                    <% if User.find(current_user.id).family_admin? || User.find(current_user.id).family_id == 0 %>
                        <%= link_to 'Create an Outfit', new_outfit_path, class: "btn btn-primary" %>
                            <% end %>
                <% end %>
            </center>
        </div>
    </div>
</div>