<div class="row">
    <div class="row">
        <div class="hide-on-mobile">
            <%= render 'shared/sidebar' %>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-8">
            <center>
                <div class="row">
                    <div class="col-sm-12">
                    <div class="col-sm-12">
                        <% unless @selected.nil? %>
                        <h2> Temperature: <%= @temp_type %> (<%=@temp%>&#8457;)</h2>
                        <h4>The weather today: <%= @weather %> <br></h4>
                        <hr>
                        <h3>
                            <% unless @selected.favorite? %>
                                <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
                                <% else %>
                                    <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span>
                                    <% end %>
                                        <%= @selected.name %>
                                            #
                                            <%= @selected.id %>
                        </h3>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12">

                        <%= link_to image_tag(@selected.picture.url), @selected %>
                    </div>
                </div>

                <div class="row center">
                    <div class="col-sm-12">
                        <p>
                            <strong>Temperature Type:</strong>
                            <%= @selected.temperature_type.name %>
                        </p>

                        <p>
                            <strong>Style:</strong>
                            <%= @selected.style_type.name %>
                        </p>
                        <p>
                            <strong>Description:</strong>
                            <%= @selected.description %>
                        </p>
                        <%= link_to 'See Outfit Details', @selected, class: "btn btn-primary" %>
                    </div>
                    </div>
                    <% else %>
                    <h3>You don't have any available outfits for this <%= @temp_type %> (<%=@temp%>&#8457;) day.</h3>
                    <% if User.find(current_user.id).family_admin?%>
                    <%= link_to 'Create an Outfit', new_outfit_path, class: "btn btn-primary" %>
                    <% end %>
                    <% end %>
            </center>
            </div>
            </div>
        </div>
    </div>
</div>