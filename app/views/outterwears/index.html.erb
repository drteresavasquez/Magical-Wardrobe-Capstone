<div class="row">      

  <div class="hide-on-mobile">
    <%= render 'shared/sidebar' %>
  </div>


<div class="row">
  <div class="col-sm-8">

<center>
  <% if @outterwear.empty? %>
  <center><h1>No Outerwear...</h1>
  <%= link_to 'Add an Outerwear', new_outterwear_path, class: "btn btn-primary" %></center>
  <hr>
      <% else %>
      <center><h1>Outerwear</h1></center>
      <hr>
    <% @outterwear.each do |outterwear| %>
    <div class="col-sm-4">
      <div class="thumbnail">
        <% if outterwear.picture? %>
        <%= link_to image_tag(outterwear.picture.url), outterwear %> 
        <% end %>
        <div class="caption">
          <h4> 
            <% unless outterwear.favorite? %>
            <%= link_to fa_icon("heart", class: "fa fa-heart"), outterwear %>
            <% else %>
            <%= link_to fa_icon("heart", class: "fa fa-heart fav"), outterwear %>
            <!-- <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span> -->
            <% end %>
            <%= outterwear.name %> #<%= outterwear.item_id %>
          </h4>
          <p><strong>Status:</strong>
            <% if outterwear.active? %>
            Clean
            <% else %>
            Dirty
            <% end %></p>
            <p><strong>Wearer:</strong> <%=User.find(outterwear.wearer_id).name %></p>
            <%= form_for(outterwear) do |form| -%>
            <% if outterwear.active? %>
            <%= form.hidden_field :active, :value => false %>
            <%= submit_tag 'Wear This!', class: "btn btn-info" -%>
              <% else %>
              <%= form.hidden_field :active, :value => true %>
              <%= submit_tag 'Wash This!', class: "btn btn-warning" -%>
            <% end %>
            <% end %>
          <p> <center><%= link_to 'Info', outterwear, class: "btn btn-info"%>
            <%= link_to 'Edit', edit_outterwear_path(outterwear), class: "btn btn-warning" %>
            <%= link_to 'Delete', outterwear, method: :delete, class: "btn btn-danger", data: { confirm: 'Are you sure?' } %></center></p>
        </div>
      </div>
    </div>
    <% end %>
    <% end %>
  </center>
  </div>
</div>
</div>
