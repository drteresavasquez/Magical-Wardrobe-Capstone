</p>
<div class="row">      
<div class="row">
  <div class="hide-on-mobile">
    <%= render 'shared/sidebar' %>
  </div>
</div>

<div class="row">
  <div class="col-sm-8">
      <% if @top.empty? %>
      <center><h3>You Don't Have Any Worn Tops...</h3>
      <%= link_to 'Add a Top', new_top_path, class: "btn btn-primary" %></center>
    <% else %>
    <center><h1>Worn Tops</h1></center>
  <% @top.each do |top| %>
  <div class="col-sm-4">
    <div class="thumbnail">
      <% if top.picture? %>
      <%= link_to image_tag(top.picture.url), top %> 
      <% end %>
      <div class="caption">
        <h4> 
          <% unless top.favorite? %>
          <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
          <% else %>
          <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span>
          <% end %>
          <%= top.name %>
        </h4>
        <p><strong>Status:</strong>
          <% if top.active? %>
          Clean
          <% else %>
          Dirty
          <% end %></p>
        <p> <%= link_to 'Info', top, class: "btn btn-info"%>
          <%= link_to 'Edit', edit_top_path(top), class: "btn btn-warning" %>
          <%= link_to 'Delete', top, method: :delete, class: "btn btn-danger", data: { confirm: 'Are you sure?' } %></p>
      </div>
    </div>
  </div>
  <% end %>
  <% end %>
</div>
</div>
</div>