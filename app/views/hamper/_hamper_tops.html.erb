<% if @top.empty? %>
<center><h3>You Don't Have Dirty Clothes!</h3>
<% else %>
<center><h1>Worn Tops</h1>  <%= button_to 'Wash All Tops', hamper_wash_all_path, class: "btn btn-success wearthis", method: :post %></center>
<% @top.each do |top| %>
<div class="col-sm-4">
<div class="thumbnail">
<% if top.picture? %>
<%= link_to image_tag(top.picture.url), top %> 
<% end %>
<div class="caption">
  <h4> 
    <% unless top.favorite? %>
    <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
    <% else %>
    <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span>
    <% end %>
    <%= top.name %>
  </h4>
  <p><strong>Status:</strong>
    <% if top.active? %>
    Clean
    <% else %>
    Dirty
    <% end %></p>
   
    <%= form_for(top) do |form| -%>
      <%= form.hidden_field :active, :value => true %>
      <%= submit_tag 'Wash This!', class: "btn btn-warning wearthis" -%>
    <% end %>
</div>
</div>
</div>
<% end %>
<% end %>