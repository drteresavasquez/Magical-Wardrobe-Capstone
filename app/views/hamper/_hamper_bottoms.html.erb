
<% @bottom.each do |bottom| %>
<div class="col-sm-4">
<div class="thumbnail">
<% if bottom.picture? %>
<%= link_to image_tag(bottom.picture.url), bottom %> 
<% end %>
<div class="caption">
  <h4> 
    <% unless bottom.favorite? %>
    <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
    <% else %>
    <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span>
    <% end %>
    <%= bottom.name %>
    #<%= bottom.id %>
  </h4>
  <p><strong>Status:</strong>
    <% if bottom.active? %>
    Clean
    <% else %>
    Dirty
    <% end %></p>
   
    <%= form_for(bottom) do |form| -%>
      <%= form.hidden_field :active, :value => true %>
      <%= submit_tag 'Wash This!', class: "btn btn-warning" -%>
    <% end %>
</div>
</div>
</div>
<% end %>