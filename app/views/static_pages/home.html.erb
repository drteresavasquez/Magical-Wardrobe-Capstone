<% provide(:title, "Home") %>

    <% if logged_in? %>
        <div class="row">
                <%= render 'shared/sidebar' %>
            </div>
            <div class="col-sm-9 hide-on-mobile">
                <div class="row">
                    <%= render 'recent_tops' %>
                </div>
            </div>
        </div>
        <% else %>
            <div class="jumbotron">
                <h1>Welcome to Magic!</h1>
                <p>...</p>
                <p>
                    <%= link_to "Sign up now!", signup_path, class: "btn btn-lg btn-primary" %>
                </p>
            </div>
            <% end %>