
<div class="row">      
    <div class="row">
      <div class="hide-on-mobile">
        <%= render 'shared/sidebar' %>
      </div>
    </div>
    <div class="row">
        <div class="col-sm-8">
        <center><h3>
            <% unless @accessory.favorite? %>
            <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
            <% else %>
            <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span>
            <% end %>
            <%= @accessory.name %> #<%= @accessory.id %></h3>
            <%= image_tag @accessory.picture.url if @accessory.picture? %>    
        <p>
          <strong>Weather Type:</strong>
          <%= @accessory.weather_type.name %>
        </p>
    
        <p>
          <strong>Accessory type:</strong>
          <%= @accessory.accessory_type.name %>
        </p>
    
        <p>
          <strong>Style:</strong>
          <%= @accessory.style_type.name %>
        </p>
    
        <p>
          <strong>Description:</strong>
          <%= @accessory.description %>
        </p>
          <%= link_to 'See All Accessories', accessories_path, class: "btn btn-primary" %>  
          <%= link_to 'Edit', edit_accessory_path(@accessory), class: "btn btn-primary" %>
           <%= link_to 'Delete', @accessory, method: :delete, class: "btn btn-danger", data: { confirm: 'Are you sure?' } %>
          </center>
          </div>
        </div>
      </div>
    