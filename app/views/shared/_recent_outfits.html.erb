
<center>
        <% if @outfit.empty? %>
          <center>
            <h3>You Don't Have Any Outfits...</h3>
            <%= link_to 'Add an Outfit', new_outfit_path, class: "btn btn-primary" %>
          </center>
          <% else %>
            <h3>Recently Added Outfits</h3>
            <% @outfit.each do |outfit| %>
              <div class="col-sm-3">
                <div class="thumbnail">
                  <%= link_to image_tag(outfit.picture.url), outfit %>
                    <div class="caption">
                      <h5>
                        <% unless outfit.favorite? %>
                          <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
                          <% else %>
                            <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span>
                            <% end %>
                              <%= outfit.name %> #<%= outfit.id %>
                      </h5>
                      <p>
                        <strong>Status:</strong>
                        <% if outfit.active? %>
                          Clean
                          <% else %>
                            Dirty
                            <% end %>
                      </p>
                      <p>
                        <%= link_to 'Details', outfit, class: "btn btn-info"%>
                      </p>
                    </div>
                </div>
              </div>
              <% end %>
                <% end %>
              </center>
        