
<center>
        <% if @footwear.empty? %>
          <center>
            <h3>You Don't Have Any Footwear...</h3>
            <%= link_to 'Add a Pair', new_footwear_path, class: "btn btn-primary" %>
          </center>
          <% else %>
            <h3>Recently Added Footwear</h3>
            <% @footwear.each do |footwear| %>
              <div class="col-sm-3">
                <div class="thumbnail">
                  <%= link_to image_tag(footwear.picture.url), footwear %>
                    <div class="caption">
                      <h5>
                        <% unless footwear.favorite? %>
                          <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
                          <% else %>
                            <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span>
                            <% end %>
                              <%= footwear.name %> #<%= footwear.id %>
                      </h5>
                      <p>
                        <%= link_to 'Details', footwear, class: "btn btn-info"%>
                      </p>
                    </div>
                </div>
              </div>
              <% end %>
                <% end %>
              </center>
