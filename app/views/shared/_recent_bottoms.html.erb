<center>
        <% if @bottom.empty? %>
          <center>
            <h3>You Don't Have Any Bottoms...</h3>
            <%= link_to 'Add a Bottom', new_bottom_path, class: "btn btn-primary" %>
          </center>
          <% else %>
            <h3>Recently Added Bottoms</h3>
            <% @bottom.each do |bottom| %>
              <div class="col-sm-3">
                <div class="thumbnail">
                  <%= link_to image_tag(bottom.picture.url), bottom %>
                    <div class="caption">
                      <h5>
                        <% unless bottom.favorite? %>
                          <span class="glyphicon glyphicon-heart" aria-hidden="true"></span>
                          <% else %>
                            <span class="glyphicon glyphicon-heart fav" aria-hidden="true"></span>
                            <% end %>
                              <%= bottom.name %> #<%= bottom.id %>
                      </h5>
                      <p>
                        <strong>Status:</strong>
                        <% if bottom.active? %>
                          Clean
                          <% else %>
                            Dirty
                            <% end %>
                      </p>
                      <p>
                        <%= link_to 'Details', bottom, class: "btn btn-info"%>
                      </p>
                    </div>
                </div>
              </div>
              <% end %>
                <% end %>
              </center>