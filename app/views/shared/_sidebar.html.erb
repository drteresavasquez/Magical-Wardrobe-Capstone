<% if current_user.family_admin? || User.find(current_user.id).family_id == 0  %>
<div class="sidebar-home col-sm-3">
        <section class="user_info">
            <%= render 'shared/user_info' %>
        </section>
        <section class="home-buttons">
                <p>
                <%= link_to new_top_path, class: "btn btn-primary btn-lg btn-block" do %>
                <%= image_tag("shirt.png", :alt => "tops") %> Partum Top
                <% end %>
                    </p>
                    <p>
                            <%= link_to new_bottom_path, class: "btn btn-primary btn-lg btn-block" do %>
                            <%= image_tag("pants.png", :alt => "bottoms") %> Partum Bottom
                            <% end %>
    
                    </p>

                    <p>
                            <%= link_to new_accessory_path, class: "btn btn-primary btn-lg btn-block" do %>
                            <%= image_tag("sunglasses.png", :alt => "accessories") %> Partum Accessory
                            <% end %>
    
                    </p>

                    <p>
                            <%= link_to new_footwear_path, class: "btn btn-primary btn-lg btn-block" do %>
                            <%= image_tag("shoes.png", :alt => "footwear") %> Partum Footwear
                            <% end %>
    
                    </p>

                    <p>
                            <%= link_to new_outfit_path, class: "btn btn-primary btn-lg btn-block" do %>
                            <%= image_tag("outfit.png", :alt => "outfit") %> Partum Outfit
                            <% end %>
    
                    </p>

                    <p>
                            <%= link_to hamper_path, class: "btn btn-primary btn-lg btn-block" do %>
                            <%= image_tag("laundry-basket.png", :alt => "outfit") %> Hamper
                            <% end %>
    
                    </p>

                    <p>
                            <%= link_to random_outfit_path, class: "btn btn-primary btn-lg btn-block" do %>
                            <%= image_tag("arrows.png", :alt => "random") %> Accio Outfit!
                            <% end %>
    
                    </p>
                            
                    </section>
                    </div>
                   <% else %>
                   <div class="sidebar-home col-sm-12">
                                <section class="user_info">
                                    <%= render 'shared/user_info' %>
                                </section>
                                <section class="home-buttons">
                   <p>
                                <%= link_to hamper_path, class: "btn btn-primary btn-lg btn-block" do %>
                                <%= image_tag("laundry-basket.png", :alt => "outfit") %> Hamper
                                <% end %>
        
                        </p>
    
                        <p>
                                <%= link_to random_outfit_path, class: "btn btn-primary btn-lg btn-block" do %>
                                <%= image_tag("arrows.png", :alt => "random") %> Accio Outfit!
                                <% end %>
        
                        </p>
                </section>
        </div>
                        <% end %>
        
